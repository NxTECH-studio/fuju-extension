{
  "manifest_version": 3,
  "default_locale": "ja",
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionDefaultTitle__"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://*.x.com/*", "https://twitter.com/*", "https://*.twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab", "cookies", "alarms", "identity"],
  "host_permissions": [
    "https://auth.fujupay.app/*",
    "https://emotion-model.fujupay.app/*",
    "https://x.com/*",
    "https://*.x.com/*"
  ],
  "icons": {
    "16": "logos/16.png",
    "32": "logos/32.png",
    "48": "logos/48.png",
    "128": "logos/128.png"
  }
}
