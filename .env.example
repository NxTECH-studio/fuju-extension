# AuthCore base URL used by the popup / background to call REST endpoints.
# In development, point this at the local AuthCore (`docker-compose up`) instance.
VITE_AUTHCORE_BASE_URL=http://localhost:8080

# NOTE: AuthCore must allow this extension's origin in `ALLOWED_ORIGINS` (see auth/.env).
# The extension origin looks like `chrome-extension://<extension-id>` and changes between
# unpacked installs and the published store version. Add every origin you need to
# AuthCore's CORS allow-list (and use a development-only wildcard if appropriate).

# fuju-emotion-model base URL — `/v1/{tenant}/events` への telemetry 直送先。
# SNS-backend を経由しないため、本拡張は AuthCore の Bearer をそのまま付けて model に送る。
# モデル側で対応する origin を CORS で許可しておくこと。
VITE_FUJU_MODEL_BASE_URL=https://emotion-model.fujupay.app
VITE_FUJU_MODEL_TENANT_ID=sns_a
